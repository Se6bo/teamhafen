# Wird normalerweise von install.sh erzeugt. Von Hand: kopieren nach .env und Werte setzen.
APP_NAME=Teamhafen
MODULES=vault
COMPOSE_PROFILES=vault
PUBLIC_URL=https://tresor.example.org
PUBLIC_HOST=tresor.example.org
APP_PORT=8080

# Je 64 Hex Zeichen, erzeugen mit: openssl rand -hex 32
JWT_SECRET=
CRYPTO_KEY=

ADMIN_USERNAME=admin
VW_ACCOUNT_DOMAIN=teamhafen.local
PRIVATE_VAULT_USERS=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=
